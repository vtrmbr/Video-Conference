# LiveKit Cloud project URL, e.g. wss://project-id.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated allowed browser origins
WEB_ORIGIN=http://localhost:5173
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
TOKEN_TTL_SECONDS=600
MAX_PARTICIPANTS=100
RESERVED_ROOMS=false
ALLOWED_ROOMS=
MEETING_MODE=high-reliability
ENABLE_ADVANCED_NOISE_FILTER=false

# Browser-facing API base URL. This value is safe to expose.
VITE_API_URL=http://localhost:3001
